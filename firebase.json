{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "farm-tap-1dd15",
          "appId": "1:913049305053:android:ad2263ef78e2e04f2ac034",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "farm-tap-1dd15",
          "appId": "1:913049305053:ios:9e1f48a1d76aebd92ac034",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "farm-tap-1dd15",
          "configurations": {
            "android": "1:913049305053:android:ad2263ef78e2e04f2ac034",
            "ios": "1:913049305053:ios:9e1f48a1d76aebd92ac034"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    }
  },
  "hosting": {
    "public": "webapp/out",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "payments",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "src",
        "lib/*.test.js",
        "lib/*.test.js.map"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
