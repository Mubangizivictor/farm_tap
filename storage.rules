rules_version = '2';

// Photos (animals, treatments, receipts, staff and supplier cards). Only
// members of a farm read or add its photos; a photo is at most 5 MB and an
// image. Deploy with: firebase deploy --only storage  (needs the Blaze plan).
service firebase.storage {
  match /b/{bucket}/o {
    function member(t) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/tenants/$(t)/members/$(request.auth.uid));
    }

    function image() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /tenants/{t}/photos/{name} {
      allow read: if member(t);
      allow create, update: if member(t) && image();
      allow delete: if false;
    }

    // Worker and milk-supplier ID card photos (decision 0016 §2). A new
    // photo replaces the old one at the same path.
    function admin(p) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/platformAdmins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/platformAdmins/$(request.auth.uid)).data.get('active', false) == true
        && (firestore.get(/databases/(default)/documents/platformAdmins/$(request.auth.uid)).data.role == 'owner'
          || p in firestore.get(/databases/(default)/documents/platformAdmins/$(request.auth.uid)).data.get('perms', []));
    }

    // Everyone's own profile photo (decision 0024). Any signed-in person may
    // see it (farm members, the control panel); only its owner changes it.
    match /profiles/{uid}/{name} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || image());
    }

    // Logo, company stamp and signature for documents and the website.
    match /platform/branding/{name} {
      allow read: if true;
      allow create, update: if admin('settings') && image();
      allow delete: if admin('settings');
    }

    // Receipts, invoices and refund notes, made only by the server.
    match /billing/{t}/{name} {
      allow read: if member(t) || admin('finance') || admin('support');
      allow write: if false;
    }

    match /tenants/{t}/people/{name} {
      allow read: if member(t);
      allow create, update: if member(t) && image();
      allow delete: if false;
    }
  }
}
