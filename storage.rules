rules_version = '2';

// Photos (animals, treatments, receipts, staff and supplier cards). Only
// members of a farm read or add its photos; a photo is at most 5 MB and an
// image. Deploy with: firebase deploy --only storage  (needs the Blaze plan).
service firebase.storage {
  match /b/{bucket}/o {
    function member(t) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/tenants/$(t)/members/$(request.auth.uid));
    }

    function image() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /tenants/{t}/photos/{name} {
      allow read: if member(t);
      allow create, update: if member(t) && image();
      allow delete: if false;
    }

    // Worker and milk-supplier ID card photos (decision 0016 §2). A new
    // photo replaces the old one at the same path.
    match /tenants/{t}/people/{name} {
      allow read: if member(t);
      allow create, update: if member(t) && image();
      allow delete: if false;
    }
  }
}
