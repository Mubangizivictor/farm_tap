# Copy to .env.local and fill in from Firebase console:
# Project settings -> Your apps -> (Web app) -> SDK setup and configuration -> Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=913049305053
NEXT_PUBLIC_FIREBASE_PROJECT_ID=farm-tap-1dd15
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=farm-tap-1dd15.firebasestorage.app
# Sign-in pop-up shows this domain. Use the site's own domain so it never says
# firebaseapp.com: farm-tap-1dd15.web.app now, your custom domain later.
# For `npm run dev` on localhost keep farm-tap-1dd15.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=farm-tap-1dd15.web.app

# Local testing with the Firebase emulators (no real data touched):
#   cd ~/Desktop/Apps/farm_tap/firestore && npx firebase emulators:start --only auth,firestore --project demo-farmtap --config ../firebase.json
# then in webapp/.env.local set:
# NEXT_PUBLIC_FIREBASE_EMULATORS=true
