rules_version = '2';

// FarmTap security rules (ROADMAP 7.4, decision 0014).
// - A farm's data is readable and writable only by its members.
// - Records keep their base fields; the id, farm and collection in the
//   document must match its path.
// - Append-only records (milk, deliveries, money...) can be created and
//   re-sent unchanged, never edited. Corrections are new records.
// - Nothing is ever hard-deleted from the app (soft delete with isDeleted).
// - Money, staff and settings need an owner or manager.
// - Subscription and payment confirmation are server-only (Cloud Functions).
// Tests: firestore/rules.test.mjs (npm test in firestore/).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function member(t) {
      return signedIn() && exists(/databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid));
    }

    function role(t) {
      return get(/databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid)).data.role;
    }

    function manages(t) {
      return member(t) && role(t) in ['owner', 'manager'];
    }

    // The staff record a worker signed in with phone + PIN is (decision 0016 §5).
    function myStaffId(t) {
      return get(/databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid)).data.get('staffId', null);
    }

    // A worker's PIN: the managers set a starting one, the worker their own.
    function pinOk(t, c, id) {
      return c != 'staffPins' || manages(t) || myStaffId(t) == id;
    }

    // Roles a manager may give a staff login: only the owner makes managers.
    function staffRoles(t) {
      return role(t) == 'owner' ? ['manager', 'clerk', 'worker'] : ['clerk', 'worker'];
    }

    function tenantDoc(t) {
      return get(/databases/$(database)/documents/tenants/$(t)).data;
    }

    // Read-only after the trial (binding rule 3), calculated from stored
    // dates like the app does: trial end, or paid-until plus 7 days' grace.
    // Two extra days let a phone that was offline send what it recorded
    // while the farm could still write.
    function canWrite(t) {
      let sub = tenantDoc(t).get('subscription', {});
      let slack = duration.value(2, 'd');
      return (sub.get('trialEndsAt', null) != null && request.time < sub.trialEndsAt + slack)
        || (sub.get('paidUntil', null) != null && request.time < sub.paidUntil + duration.value(9, 'd'));
    }

    function appendOnly(c) {
      return c in ['milkRecords', 'milkSales', 'deliveries', 'qualityTests', 'treatments',
        'vaccinations', 'attendance', 'payments', 'payouts', 'expenses', 'income', 'wages',
        'feedUsage', 'stockMovements', 'animalEvents', 'breedingEvents', 'auditLog', 'smsOutbox'];
    }

    // Only an owner or manager may write these.
    function managerOnly(c) {
      return c in ['staff', 'nfcCards', 'settings', 'paymentPeriods', 'farmerStatements',
        'deductions', 'payouts', 'expenses', 'income', 'wages', 'payments'];
    }

    // A subscription payment is only ever submitted from the app; Victorbee
    // confirms it on the server.
    function paymentOk(c) {
      return c != 'payments' || request.resource.data.body.get('status', '') == 'submitted';
    }

    // An SMS is only ever queued from the app; the server sends it and
    // records the result.
    function smsOk(c) {
      return c != 'smsOutbox' || request.resource.data.body.get('status', '') == 'queued';
    }

    // Written only by Cloud Functions (admin SDK skips these rules).
    function serverOnly(c) {
      return c in ['members', 'messages', 'aiQuestions', 'iotDevices', 'iotReadings'];
    }

    function softDelete() {
      let d = request.resource.data;
      return resource.data.isDeleted == false && d.isDeleted == true
        && d.version == resource.data.version + 1 && d.body == resource.data.body;
    }

    function validRecord(t, c, id) {
      let d = request.resource.data;
      return d.id == id && d.tenantId == t && d.collection == c
        && d.version is int && d.version >= 1
        && d.deviceId is string && d.createdBy is string && d.updatedBy is string
        && d.isDeleted is bool && d.body is map
        && d.serverUpdatedAt == request.time;
    }

    // One account owns one farm (decision 0018). `farmLimit` is set by
    // Victorbee for a multi-farm plan and never from the app; `ownedFarms`
    // only goes up, by one, with each farm the account creates.
    function ownedFarms(d) { return d.get('ownedFarms', 0); }
    function farmLimit(d) { return d.get('farmLimit', 1); }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && !('farmLimit' in request.resource.data)
        && ownedFarms(request.resource.data) <= 1;
      allow update: if signedIn() && request.auth.uid == uid
        && farmLimit(request.resource.data) == farmLimit(resource.data)
        && ownedFarms(request.resource.data) >= ownedFarms(resource.data)
        && ownedFarms(request.resource.data) <= ownedFarms(resource.data) + 1;
    }

    // Phone sign-in for workers (decision 0016 §5): which login version a
    // phone number has, read before sign-in. Holds no PIN and no name.
    match /staffLogins/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if manages(request.resource.data.tenantId)
        && request.resource.data.keys().hasOnly(['tenantId', 'staffId', 'uid', 'v'])
        && request.resource.data.v is int;
      allow update: if manages(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.keys().hasOnly(['tenantId', 'staffId', 'uid', 'v'])
        && request.resource.data.v > resource.data.v;
      allow delete: if manages(resource.data.tenantId);
    }

    match /waitlist/{id} {
      allow create: if true;
    }

    // The farm is created in one batch with the owner's `ownedFarms` going up
    // by one, and only while the account is under its farm limit.
    function withinFarmLimit() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return ownedFarms(before) < farmLimit(before)
        && ownedFarms(after) == ownedFarms(before) + 1;
    }

    match /tenants/{t} {
      allow read: if member(t);
      // Onboarding: the signer creates the farm as its owner, on trial.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.subscription.keys().hasOnly(['trialStartedAt', 'trialEndsAt'])
        && request.resource.data.subscription.trialEndsAt is timestamp
        && request.resource.data.subscription.trialEndsAt <= request.time + duration.value(8, 'd')
        // Every new farm waits for Victorbee's review (admin panel).
        && request.resource.data.review == {'status': 'pending'}
        && withinFarmLimit();
      // Profile edits only; subscription and review stay server-side.
      allow update: if manages(t)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'ownerUid', 'review', 'owner']);

      match /members/{uid} {
        allow read: if member(t);
        // The owner's own first membership, right after creating the farm.
        allow create: if signedIn() && uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/tenants/$(t)).data.ownerUid == request.auth.uid
          && request.resource.data.role in ['owner', 'manager'];
        allow update, delete: if member(t) && role(t) == 'owner' && uid != request.auth.uid;
        // A worker's phone sign-in, made by the owner or a manager. It is
        // tied to a staff record and never makes an owner.
        allow create, update: if manages(t) && uid != request.auth.uid
          && request.resource.data.staffId is string
          && request.resource.data.role in staffRoles(t)
          && (resource == null || resource.data.get('staffId', null) is string);
        allow delete: if manages(t) && uid != request.auth.uid
          && resource.data.get('staffId', null) is string
          && resource.data.role in staffRoles(t);
      }

      match /{c}/{id} {
        allow read: if member(t) && c != 'members';
        allow create: if member(t) && !serverOnly(c) && canWrite(t)
          && (!managerOnly(c) || manages(t))
          && paymentOk(c)
          && smsOk(c)
          && pinOk(t, c, id)
          && validRecord(t, c, id);
        allow update: if member(t) && !serverOnly(c) && canWrite(t)
          && (!managerOnly(c) || manages(t))
          && pinOk(t, c, id)
          && validRecord(t, c, id)
          && request.resource.data.createdBy == resource.data.createdBy
          // Append-only: only the same version again (a retried send), or
          // the one soft delete (Undo on a delivery), with nothing else changed.
          && (!appendOnly(c) || request.resource.data.version == resource.data.version || softDelete());
        allow delete: if false;
      }
    }
  }
}
